<?xml version="1.0" encoding="utf-8"?>
<!--
  Política de red de COBALTO: tráfico en claro (HTTP) prohibido por defecto.
  Se permite únicamente hacia hosts de desarrollo locales (LAN del operador,
  emulador y localhost) para el enlace de estación base de desarrollo.
  Cualquier otro destino debe usar TLS (HTTPS).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.102</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
</network-security-config>